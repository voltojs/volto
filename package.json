{
  "name": "volto",
  "version": "0.0.1",
  "private": true,
  "description": "Pure agent core \u2014 zero I/O, zero env coupling, capability injection",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build:fresh": "node scripts/build-fresh.mjs",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "turbo run dev --filter @volto/gateway --filter @volto/web",
    "web:export": "pnpm --filter @volto/gateway web:export",
    "check:core-deps": "node scripts/check-core-zero-deps.mjs",
    "check:pack": "pnpm build:fresh && pnpm web:export && node scripts/check-pack-contents.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "check:i18n": "node scripts/check-i18n-hardcoded.mjs",
    "release": "pnpm build:fresh && pnpm web:export && node scripts/publish-manifest.mjs --strict-workspace && pnpm check:pack && pnpm -r publish --access public",
    "version:all": "pnpm changeset version && node scripts/publish-manifest.mjs",
    "docs:gen": "node scripts/docs/gen.mjs",
    "docs:sync": "node scripts/docs/sync.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "docs:ack": "node scripts/docs/ack.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
