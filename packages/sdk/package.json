{
  "name": "@volto/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "import": "./dist/sse/index.js"
    },
    "./file-refs": {
      "types": "./dist/file-refs/index.d.ts",
      "import": "./dist/file-refs/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voltojs/volto.git"
  },
  "dependencies": {
    "@volto/core": "workspace:*",
    "@volto/tools-common": "workspace:*",
    "@volto/tool-skill": "workspace:*",
    "@volto/tools-agent": "workspace:*",
    "@volto/tools-ask": "workspace:*",
    "@volto/tools-browser": "workspace:*",
    "@volto/tools-code": "workspace:*",
    "@volto/tools-data": "workspace:*",
    "@volto/tools-document": "workspace:*",
    "@volto/tools-fs": "workspace:*",
    "@volto/tools-plan": "workspace:*",
    "@volto/tools-schedule": "workspace:*",
    "@volto/tools-shell": "workspace:*",
    "@volto/tools-vcs": "workspace:*",
    "@volto/tools-web": "workspace:*",
    "@volto/runtime-node": "workspace:*",
    "@volto/store-memory": "workspace:*",
    "@volto/tools-memory": "workspace:*",
    "zod": "^4.4.3"
  }
}
