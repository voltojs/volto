{
  "name": "@voltojs/sdk",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "import": "./dist/sse/index.js"
    },
    "./file-refs": {
      "types": "./dist/file-refs/index.d.ts",
      "import": "./dist/file-refs/index.js"
    },
    "./package.json": "./package.json",
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voltojs/volto.git"
  },
  "dependencies": {
    "@voltojs/core": "workspace:^",
    "@voltojs/runtime-node": "workspace:^",
    "zod": "^4.4.3",
    "@voltojs/tools": "workspace:^",
    "@voltojs/stores": "workspace:^"
  },
  "devDependencies": {
    "@voltojs/stores": "workspace:^"
  }
}
