{
  "name": "@volto/runtime-node",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voltojs/volto.git"
  },
  "dependencies": {
    "@volto/core": "workspace:*",
    "@volto/tools-browser": "workspace:*",
    "@volto/tools-code": "workspace:*",
    "@volto/tools-data": "workspace:*",
    "@volto/tools-document": "workspace:*",
    "@volto/tools-fs": "workspace:*",
    "@volto/tools-shell": "workspace:*",
    "@volto/tools-web": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0",
    "mammoth": ">=1.6.0",
    "pdf-parse": ">=1.1.1",
    "playwright-core": ">=1.40.0",
    "xlsx": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "pdf-parse": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@volto/eval": "workspace:*"
  }
}
