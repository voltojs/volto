{
  "name": "@voltojs/gateway",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "volto": "./dist/bin.js"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "web:build": "VOLTO_WEB_EXPORT=1 pnpm --filter @voltojs/web build",
    "web:copy": "node scripts/copy-web-assets.mjs",
    "web:export": "VOLTO_WEB_EXPORT=1 pnpm --filter @voltojs/web export && node scripts/copy-web-assets.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voltojs/volto.git"
  },
  "dependencies": {
    "@voltojs/core": "workspace:*",
    "@voltojs/runtime-node": "workspace:*",
    "@voltojs/sdk": "workspace:*",
    "@voltojs/store-sqlite": "workspace:*",
    "ws": "^8.16.0",
    "@voltojs/tools": "workspace:*",
    "@voltojs/memories": "workspace:*",
    "@voltojs/providers": "workspace:*",
    "@voltojs/stores": "workspace:*"
  },
  "optionalDependencies": {
    "playwright-core": "^1.60.0",
    "typescript-language-server": "^5.3.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "tsx": "^4.23.13",
    "@voltojs/sdk": "workspace:*"
  }
}
