{
  "name": "@agent-core/reference-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=.env dist/main.js",
    "dev:strict": "node --env-file=.env dist/main.js"
  },
  "dependencies": {
    "@agent-core/core": "workspace:*",
    "@agent-core/sdk": "workspace:*",
    "@agent-core/provider-openai": "workspace:*",
    "@agent-core/runtime-node": "workspace:*",
    "@agent-core/tools-plan": "workspace:*"
  }
}
