{
  "name": "@volto/reference-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=.env dist/main.js",
    "dev:strict": "node --env-file=.env dist/main.js"
  },
  "dependencies": {
    "@volto/core": "workspace:*",
    "@volto/sdk": "workspace:*",
    "@volto/provider-openai": "workspace:*",
    "@volto/runtime-node": "workspace:*",
    "@volto/store-file": "workspace:*",
    "@volto/tools-plan": "workspace:*"
  }
}
