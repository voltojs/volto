# ─────────────────────────────────────────────────────────────────────────────
# @volto/reference-cli — 环境变量样例
#
# 用法：
#   cp .env.example .env        # 拷一份本地配置
#   set -a && source .env && set +a
#   node dist/main.js
#
# 也可以直接 inline：
#   AGENT_TRACE=true OPENAI_API_KEY=sk-... node dist/main.js
#
# 约定：
#   - 注释行以 # 开头
#   - 留空 / 删除变量 = 走默认值（每项注释里有标注）
#   - 布尔类变量统一用 "true" / "false" 字符串（main.ts 严格匹配）
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# [必填] 模型 / API
# ═════════════════════════════════════════════════════════════════════════════

# OpenAI / OpenAI 兼容 API 的 key（必填，缺失会 exit 1）
OPENAI_API_KEY=sk-your-api-key-here

# 模型名（默认 gpt-4o）
AGENT_MODEL=gpt-4o

# OpenAI 兼容端点的 baseURL（可选，留空走官方）
# 示例：自托管 / 国内代理 / DeepSeek / Moonshot 等
# OPENAI_BASE_URL=https://api.openai.com/v1


# ═════════════════════════════════════════════════════════════════════════════
# 工作区 / 权限
# ═════════════════════════════════════════════════════════════════════════════

# Agent 视角的根目录（fs / shell 工具都被限定在此目录内，默认 process.cwd()）
# 强烈建议指定一个隔离的临时目录，避免误改宿主工作区
AGENT_CWD=/tmp/agent-sandbox

# 权限策略模式（默认 auto-allow）
#   - auto-allow : 自动放行所有可见工具（开发 / 测试用）
#   - plan       : 高风险工具触发 HITL 审批（生产 / 真实使用推荐）
AGENT_PERMISSION_MODE=auto-allow


# ═════════════════════════════════════════════════════════════════════════════
# 可观测性（端到端 trace / audit / telemetry）
# ═════════════════════════════════════════════════════════════════════════════

# 开启全链路追踪：stderr 涂色打印每个 EventSink 事件，退出时 dump telemetry
# 默认 false，仅 "true" 字符串会启用
AGENT_TRACE=true

# 把 trace 事件持久化为 JSONL（可选，留空仅 stderr 输出）
# 父目录会自动创建；适合事后用 jq 离线分析
AGENT_TRACE_FILE=/tmp/agent-logs/trace.jsonl

# 事件类型白名单（可选，逗号分隔；留空 = 全部输出）
# 常用事件：
#   text_delta, reasoning_delta, tool_use_delta, tool_result,
#   model_done, model_retry, model_error,
#   approval_decision, request_approval, self_correct,
#   budget_exceeded, cancel, cost_update
# 示例：只看工具调用 + 模型完成 + 错误
# AGENT_TRACE_INCLUDE=tool_use_delta,tool_result,model_done,model_error

# 退出时是否 dump InMemoryTelemetry 的 spans/metrics 到 stderr
# 默认 true（仅当 AGENT_TRACE=true 时生效）；设 "false" 关闭
# AGENT_TRACE_TELEMETRY=false

# 高风险工具执行 / 审批决策的结构化审计日志（JSONL）
# 留空 = 不记录；建议生产 / 真实使用时打开
AGENT_AUDIT_FILE=/tmp/agent-logs/audit.jsonl

# 标准 NO_COLOR 协议（https://no-color.org/）
# 设任何非空值禁用 ANSI 涂色；非 TTY 时也会自动禁用
# NO_COLOR=1


# ═════════════════════════════════════════════════════════════════════════════
# 沙箱（Plan 009 / 隔离执行）
# ═════════════════════════════════════════════════════════════════════════════

# 沙箱模式（留空 = 不启用沙箱）
#   - read-only           : 只读文件系统
#   - workspace-write     : 仅允许写入 AGENT_CWD（推荐）
#   - danger-full-access  : 全权访问（仅在你确切需要时使用）
# AGENT_SANDBOX_MODE=workspace-write

# 沙箱允许联网的主机白名单（逗号分隔，留空 = 完全断网）
# 仅当 AGENT_SANDBOX_MODE 已设置时生效
# AGENT_SANDBOX_ALLOW_HOSTS=api.openai.com,registry.npmjs.org


# ═════════════════════════════════════════════════════════════════════════════
# 可选适配器（按需启用，未配置自动跳过；缺失依赖会打 warning 并继续）
# ═════════════════════════════════════════════════════════════════════════════

# SQLite 数据库适配器（让 data 工具能读写 SQLite 文件）
# 启用前需安装：pnpm add better-sqlite3
# AGENT_DB_FILE=/tmp/agent-sandbox/data.db

# 文档解析器：PDF / DOCX / XLSX
# 启用前需安装：pnpm add pdf-parse mammoth xlsx
# AGENT_DOCUMENT_PARSER=true

# 浏览器适配器（headless Playwright，让 browser 工具可用）
# 启用前需安装：pnpm add playwright && pnpm exec playwright install chromium
# AGENT_BROWSER=true

# LSP 客户端（让 code 工具调用真实语言服务器）
# 示例：
#   AGENT_LSP_COMMAND=typescript-language-server
#   AGENT_LSP_ARGS=--stdio
# 多个参数用逗号分隔
# AGENT_LSP_COMMAND=
# AGENT_LSP_ARGS=
