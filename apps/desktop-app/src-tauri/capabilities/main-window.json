{
  "identifier": "main-window-drag",
  "description": "The gateway page may only drag/maximize the window; app commands still reject this webview.",
  "local": false,
  "remote": {
    "urls": [
      "http://*:*",
      "https://*:*"
    ]
  },
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
