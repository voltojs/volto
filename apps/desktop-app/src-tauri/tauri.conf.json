{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volto Desktop",
  "version": "0.0.1",
  "identifier": "com.volto.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Native shell for Volto gateways",
    "longDescription": "Volto Desktop connects to a local or remote Volto gateway and shows the gateway's own web UI.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
